diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index 2b61c2be..aa8e44ea 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -301,3 +301,16 @@ void __exit ksu_sucompat_exit()
 {
     ksu_unregister_feature_handler(KSU_FEATURE_SU_COMPAT);
 }
+#ifdef CONFIG_KSU_SUSFS
+// Adapter stubs: 50_add_susfs inserts kernel-side manual hooks (fs/exec.c, fs/open.c,
+// fs/stat.c, fs/read_write.c) that call these. KOWX keeps its native tracepoint
+// dispatcher for su-handling and marks umounted procs via the setuid hook, so these
+// are no-ops purely to satisfy the linker (susfs core hiding is VFS-level in fs/susfs.c).
+int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv, void *envp, int *flags) { return 0; }
+int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv, void *envp, int *flags) { return 0; }
+int ksu_handle_faccessat(int *dfd, const char __user **filename_user, int *mode, int *flags) { return 0; }
+int ksu_handle_stat(int *dfd, struct filename **filename, int *flags) { return 0; }
+void ksu_handle_sys_read(unsigned int fd) { }
+void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr) { }
+#endif
+
