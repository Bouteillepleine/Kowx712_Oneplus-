 {
@@ -125,6 +131,9 @@ void cache_sid(void)
     } else {
         pr_info("Cached su SID: %u\n", cached_su_sid);
     }
+#ifdef CONFIG_KSU_SUSFS
+    susfs_ksu_sid = cached_su_sid;
+#endif
 
     err = security_secctx_to_secid(ZYGOTE_CONTEXT, strlen(ZYGOTE_CONTEXT), &cached_zygote_sid);
     if (err) {
@@ -220,3 +229,12 @@ void escape_to_root_for_adb_root(void)
     }
     commit_creds(cred);
 }
+
+#ifdef CONFIG_KSU_SUSFS
+// susfs asks whether the current task runs in the KSU SELinux domain so it can exempt
+// ksu itself from hiding. Reuse KOWX's cached su SID matcher.
+bool susfs_is_current_ksu_domain(void)
+{
+    return is_sid_match(current_cred(), cached_su_sid, KERNEL_SU_CONTEXT);
+}
+#endif
